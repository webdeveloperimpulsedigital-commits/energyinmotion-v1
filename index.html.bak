		<script>
		document.addEventListener('DOMContentLoaded', function() {
			const eventBtns = document.querySelectorAll('.event-tab-btn');
			const eventPanes = document.querySelectorAll('.event-tab-pane');

			eventBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					eventBtns.forEach(b => b.classList.remove('active'));
					eventPanes.forEach(p => p.classList.remove('active'));

					btn.classList.add('active');
					const targetPane = document.getElementById(`event-${btn.dataset.eventTab}`);
					if (targetPane) {
						targetPane.classList.add('active');
					}
				});
			});
		});
		</script>

