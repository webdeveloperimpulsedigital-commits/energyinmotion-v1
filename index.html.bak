	<main class="main">
		<section id="hero" class="hero section dark-background">
			<!-- Desktop Video -->
			<video autoplay muted loop playsinline class="hero-video-bg hide-mob" id="hero-video-desktop">
				<!-- Source loaded dynamically to save bandwidth -->
			</video>
			<!-- Mobile Video -->
			<video autoplay muted loop playsinline class="hero-video-bg hide-desk" id="hero-video-mobile">
				<!-- Source loaded dynamically to save bandwidth -->
			</video>
			<script>
				(function() {
					var isMobile = window.innerWidth <= 767;
					if (isMobile) {
						var mobVid = document.getElementById('hero-video-mobile');
						if (mobVid) {
							mobVid.src = "images/mobile.mp4";
						}
					} else {
						var deskVid = document.getElementById('hero-video-desktop');
						if (deskVid) {
							deskVid.src = "images/desktop.mp4";
						}
					}
				})();
			</script>
			<div class="hero-bg"></div>
			<div class="container hero-container">
				<div class="hero-cta-wrapper" data-aos="fade-up" data-aos-delay="800">
					<a href="images/EIM.pdf" target="_blank" class="hero-cta-btn">
						<svg class="download-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
							<polyline points="7 10 12 15 17 10"></polyline>
							<line x1="12" y1="15" x2="12" y2="3"></line>
						</svg>
						<span>Download Company Brochure</span>
					</a>
				</div>
			</div>

		</section>



		<section id="overview" class="company overview section bg-blue">
			<div class="container">
				<!-- Row 1: Header + Text -->
				<div class="overview-header text-center" data-aos="fade-up">
					<h2 class="main-title">Overview</h2>
					<p class="overview-lead-text">
						We are building India's integrated electric freight ecosystem - combining advanced electric vehicles, battery swapping, charging infrastructure, and intelligent support services. Our solutions help enterprises transition to cleaner transport while improving operational efficiency, reducing total cost of ownership, and minimizing technology risk.
					</p>
				</div>
				<!-- Row 2: Sliding Accordion Panels Grid -->
				<div class="overview-accordion-grid" data-aos="fade-up" data-aos-delay="200">
					<!-- Panel 1: Drive -->
					<div class="accordion-panel active" style="background-image: url('images/overview-1.png');"></div>

					<!-- Panel-2: Energize -->
					<div class="accordion-panel" style="background-image: url('images/overview-2.png');"></div>

					<!-- Panel 3: Charge -->
					<div class="accordion-panel" style="background-image: url('images/overview-3.png');"></div>
				</div>
			</div>
		</section>

		<script>
		document.addEventListener('DOMContentLoaded', function() {
			const panels = document.querySelectorAll('.accordion-panel');

			panels.forEach(panel => {
				panel.addEventListener('mouseenter', () => {
					panels.forEach(p => p.classList.remove('active'));
					panel.classList.add('active');
				});
				panel.addEventListener('click', () => {
					panels.forEach(p => p.classList.remove('active'));
					panel.classList.add('active');
				});
			});

			const servicesPanels = document.querySelectorAll('.services-panel');

			servicesPanels.forEach(panel => {
				panel.addEventListener('mouseenter', () => {
					servicesPanels.forEach(p => p.classList.remove('active'));
					panel.classList.add('active');
				});
				panel.addEventListener('click', () => {
					servicesPanels.forEach(p => p.classList.remove('active'));
					panel.classList.add('active');
				});
			});

			const rows = document.querySelectorAll('.deck-row');

			rows.forEach(row => {
				row.addEventListener('mouseenter', () => {
					rows.forEach(r => r.classList.remove('active'));
					row.classList.add('active');
				});
				row.addEventListener('click', () => {
					rows.forEach(r => r.classList.remove('active'));
					row.classList.add('active');
				});
			});
		});
		</script>
		<section id="solutions" class="solution section">
			<div class="container">
				<h2 class="main-title text-center mb55 transform-none" data-aos="fade-up">Barriers & Solutions to Truck Electrification</h2>
				
				<div class="solutions-deck">
					<!-- Row 1: Capital Investment -->
					<div class="deck-row active" data-aos="fade-up" data-aos-delay="100">
						<!-- Big Index Number -->
						<div class="deck-num-col">
							<span class="deck-num">01</span>
						</div>
						
						<!-- Split Columns Content -->
						<div class="deck-content-col">
							<!-- Challenge Side -->
							<div class="deck-side challenge-side-col">
								<span class="deck-tag tag-red">The Challenge</span>
								<h3>Reduce Capital Investment</h3>
								<p>Electric trucks often require substantially higher upfront investment than conventional diesel vehicles.</p>
							</div>
							
							<!-- Vertical Laser Line -->
							<div class="deck-divider"></div>
							
							<!-- EIM Solution Side -->
							<div class="deck-side sol-side">
								<span class="deck-tag tag-teal">EIM Solution</span>
								<h3>Battery-as-a-Service</h3>
								<p>Lower acquisition costs by separating battery ownership from the vehicle.</p>
							</div>
						</div>
					</div>

					<!-- Row 2: Charging Downtime -->
					<div class="deck-row" data-aos="fade-up" data-aos-delay="200">
						<!-- Big Index Number -->
						<div class="deck-num-col">
							<span class="deck-num">02</span>
						</div>
						
						<!-- Split Columns Content -->
						<div class="deck-content-col">
							<!-- Challenge Side -->
							<div class="deck-side challenge-side-col">
								<h3>Charging Downtime</h3>
								<p>Evs have 6X higher refuelling down-time compared to diesel truck</p>
							</div>
							
							<!-- Vertical Laser Line -->
							<div class="deck-divider"></div>
							
							<!-- EIM Solution Side -->
							<div class="deck-side sol-side">
								<h3>Battery Swapping</h3>
								<p>Automated Battery Swapping gets trucks back on the road in minutes, maximizing fleet productivity.</p>
							</div>
						</div>
					</div>

					<!-- Row 3: Route Reliability -->
					<div class="deck-row" data-aos="fade-up" data-aos-delay="300">
						<!-- Big Index Number -->
						<div class="deck-num-col">
							<span class="deck-num">03</span>
						</div>
						
						<!-- Split Columns Content -->
						<div class="deck-content-col">
							<!-- Challenge Side -->
							<div class="deck-side challenge-side-col">
								<h3>Route Reliability</h3>
								<p>Limited charging infrastructure and extended charging times can disrupt fleet operations and constrain business growth.</p>
							</div>
							
							<!-- Vertical Laser Line -->
							<div class="deck-divider"></div>
							
							<!-- EIM Solution Side -->
							<div class="deck-side sol-side">
								<h3>Smart Energy Management</h3>
								<p>Intelligently coordinates battery swapping, charging, and fleet deployment to maximize uptime, optimize energy availability, and keep freight moving with confidence.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="maitryi" class="maitryi-section py-5 bg-white">
			<div class="container text-center">
				<h2 class="main-title mb-5" data-aos="fade-up">‘Maitryi’ as a Business Model</h2>
				<div class="maitryi-img-wrap" data-aos="fade-up" data-aos-delay="100">
					<img src="images/Maitryi-Model.png" alt="Maitryi as a Business Model" class="img-fluid rounded-4 shadow-sm" loading="lazy">
				</div>
			</div>
		</section>
		<section id="offerings" class="offerings section bg-light1">
			<div class="container">
				<h2 class="main-title text-center mb50" data-aos="fade-up">Offerings</h2>
				
				<div class="offerings-split-layout">
					<!-- Left Column: Content Points Grouped in Pairs (3 groups of 2) -->
					<div class="offerings-points-column" data-aos="fade-right">
						
						<!-- Group 1 -->
						<div class="offering-group-row">
							<!-- Point 1 -->
							<div class="offering-point-item active" data-offering="1">
								<div class="point-content">
									<h3>Next-Generation Electric Tractor</h3>
									<p>Engineered for high-performance heavy-duty freight.</p>
								</div>
							</div>
							<!-- Point 2 -->
							<div class="offering-point-item" data-offering="2">
								<div class="point-content">
									<h3>Integrated Charging Network</h3>
									<p>Reliable energy infrastructure designed for uninterrupted operations.</p>
								</div>
							</div>
						</div>

						<!-- Group 2 -->
						<div class="offering-group-row">
							<!-- Point 3 -->
							<div class="offering-point-item" data-offering="3">
								<div class="point-content">
									<h3>Automated Battery Swapping</h3>
									<p>Automated battery exchange in minutes to maximize fleet uptime.</p>
								</div>
							</div>
							<!-- Point 4 -->
							<div class="offering-point-item" data-offering="4">
								<div class="point-content">
									<h3>Battery-as-a-Service</h3>
									<p>Flexible subscription model that lowers upfront investment and simplifies ownership.</p>
								</div>
							</div>
						</div>

						<!-- Group 3 -->
						<div class="offering-group-row">
							<!-- Point 5 -->
							<div class="offering-point-item" data-offering="5">
								<div class="point-content">
									<h3>Intelligent Energy Management</h3>
									<p>Smart software optimizes battery allocation, charging, and fleet scheduling.</p>
								</div>
							</div>
							<!-- Point 6 -->
							<div class="offering-point-item" data-offering="6">
								<div class="point-content">
									<h3>Powered by Renewable Energy</h3>
									<p>Supporting cleaner, lower-carbon logistics through sustainable energy infrastructure.</p>
								</div>
							</div>
						</div>

					</div>

					<!-- Right Column: Sticky Media Display -->
					<div class="offerings-sticky-media-column" data-aos="fade-left">
						<div class="offerings-image-display">
							<div class="offering-display-img active" data-offering-img="1" style="background-image: url('images/offering-1.png');"></div>
							<div class="offering-display-img" data-offering-img="2" style="background-image: url('images/offering-2.png');"></div>
							<div class="offering-display-img" data-offering-img="3" style="background-image: url('images/offering-3.png');"></div>
							<div class="offering-display-img" data-offering-img="4" style="background-image: url('images/offering-1.png');"></div>
							<div class="offering-display-img" data-offering-img="5" style="background-image: url('images/offering-2.png');"></div>
							<div class="offering-display-img" data-offering-img="6" style="background-image: url('images/offering-3.png');"></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<script>
		document.addEventListener('DOMContentLoaded', function() {
			const points = document.querySelectorAll('.offering-point-item');
			const images = document.querySelectorAll('.offering-display-img');

			if (points && images) {
				points.forEach(point => {
					point.addEventListener('mouseenter', function() {
						const index = this.getAttribute('data-offering');
						
						// Set active point
						points.forEach(p => p.classList.remove('active'));
						this.classList.add('active');

						// Set active image
						images.forEach(img => {
							if (img.getAttribute('data-offering-img') === index) {
								img.classList.add('active');
							} else {
								img.classList.remove('active');
							}
						});
					});
				});
			}
		});
		</script>
		<section id="services" class="services-21st-section py-5">
			<div class="container">
				<h2 class="main-title text-center mb50" data-aos="fade-up">Services & E-Tractors</h2>

				<!-- Services Accordion Grid -->
				<div class="services-accordion-grid" data-aos="fade-up" data-aos-delay="200">
					<!-- Panel 1: Swapping Infrastructure -->
					<div class="services-panel active" style="background-image: url('images/overview-1.png');">
						<div class="services-panel-overlay">
							<div class="services-panel-body">
								<h3 class="services-panel-h3">Automated Battery Swapping & Charging Hub</h3>
								<p class="services-panel-p">A fully automated energy hub that enables rapid battery swapping while simultaneously charging multiple battery packs and electric vehicle.</p>
							</div>
						</div>
					</div>

					<!-- Panel 2: E-Tractors -->
					<div class="services-panel" style="background-image: url('images/overview-3.png');">
						<div class="services-panel-overlay">
							<div class="services-panel-body">
								<h3 class="services-panel-h3">Next-Generation Electric Tractor</h3>
								<p class="services-panel-p">Purpose-built for heavy-duty commercial applications, the EIM electric tractor features an advanced swappable battery platform that delivers faster turnaround, greater operational flexibility, and seamless integration with EIM's energy ecosystem.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<script>
		document.addEventListener('DOMContentLoaded', function() {
			const spans = document.querySelectorAll('.services-panel');
			spans.forEach(span => {
				span.addEventListener('mouseenter', () => {
					spans.forEach(s => s.classList.remove('active'));
					span.classList.add('active');
				});
			});
		});
		</script>

		<section id="networks" class="networks bg-dark section ptpb85">
			<div class="container d-flex justify-content-between align-items-center">
				<div class="charge-left">
					<h2 class="main-title" data-aos="fade-up">Charging Network</h2>
					<p class="big-txt1" data-aos="fade-up" data-aos-delay="100">
						Future Ready Charging Networks <br>
						<span class="highlight-sub">Deployment Roadmap</span>
					</p>
					<ul class="timeline">
						<li data-aos="fade-up" data-aos-delay="150">
							<div class="year"><span>2025</span></div>
							<div class="year-txt">Introduce <strong>22 Swapping Stations</strong> at major logistics hubs throughout India, each capable of servicing 100 e-trucks per day.</div>
						</li>
						<li data-aos="fade-up" data-aos-delay="250">
							<div class="year"><span>2027</span></div>
							<div class="year-txt">Target the deployment of <strong>45 additional stations</strong> in sectors like cement, steel, and mining, enhancing the overall charging network for electric vehicles.</div>
						</li>
					</ul>
				</div>
				<div class="charge-right">
					<div class="map-cont" data-aos="fade-up">
						<img src="images/eim-network.svg" alt="India Charging Network Map">
					</div>
				</div>
			</div>
		</section>

		<section id="events" class="event-section py-5 bg-blue">
			<div class="container">
				<!-- Section Title -->
				<h2 class="main-title text-center mb50" data-aos="fade-up">Events</h2>

				<!-- Event Tabs Switcher -->
				<div class="event-tabs-nav" data-aos="fade-up" data-aos-delay="150">
					<button class="event-tab-btn active" data-event-tab="event1">
						<span class="event-date">August 2024</span>
						<span class="event-title-sub">1st EV Fast Charger</span>
					</button>
					<button class="event-tab-btn" data-event-tab="event2">
						<span class="event-date">September 2025</span>
						<span class="event-title-sub">First EV Fleet Flag Off</span>
					</button>
					<button class="event-tab-btn" data-event-tab="event3">
						<span class="event-date">October 2025</span>
						<span class="event-title-sub">1st Public Swapping Station</span>
					</button>
					<button class="event-tab-btn" data-event-tab="event4">
						<span class="event-date">May 2026</span>
						<span class="event-title-sub">India's Largest Station</span>
					</button>
				</div>

				<!-- Event Tab Content -->
				<div class="event-tabs-content" data-aos="fade-up" data-aos-delay="200">
					<!-- Event 1: August 2024 -->
					<div class="event-tab-pane active" id="event-event1">
						<div class="event-stacked-card">
							<!-- Top Content: Info Header -->
							<div class="event-info-header">
								<div class="event-info-left">
									<h3 class="event-heading">1st EV Fast Charger in JNPT</h3>
									<div class="event-description">
										<div class="desc-icon"><img src="images/icon-star.svg" alt=""></div>
										<p class="desc-text">Inauguration of India's first high-capacity EV Fast Charging infrastructure within the Jawaharlal Nehru Port (JNPT) premises to support heavy-duty fleet operations.</p>
									</div>
								</div>
								<div class="event-info-right">
									<ul class="event-meta-list">
										<li>
											<div class="meta-icon"><img src="images/icon-calendar.svg" alt=""></div>
											<div class="meta-txt">
												<span class="meta-label">Date</span>
												<span class="meta-val">15th August 2024</span>
											</div>
										</li>
										<li>
											<div class="meta-icon"><img src="images/icon-location.svg" alt=""></div>
											<div class="meta-txt">
												<span class="meta-label">Location</span>
												<span class="meta-val">Jawaharlal Nehru Port, Mumbai</span>
											</div>
										</li>
										<li>
											<div class="meta-icon"><img src="images/icon-inaugration.svg" alt=""></div>
											<div class="meta-txt">
												<span class="meta-label">Inaugurated By</span>
												<span class="meta-val">Shri Unmesh Wagh, Chairman, Jawaharlal Nehru Port Authority</span>
											</div>
										</li>
									</ul>
								</div>
							</div>
							
							<!-- Bottom Content: Widescreen Image -->
							<div class="event-widescreen-photo">
								<img src="images/JNPT-Charger.JPG" alt="1st EV Fast Charger in JNPT" loading="lazy">
							</div>
						</div>
					</div>

					<!-- Event 2: September 2025 -->
					<div class="event-tab-pane" id="event-event2">
						<div class="event-stacked-card">
							<!-- Top Content: Info Header -->
							<div class="event-info-header">
								<div class="event-info-left">
									<h3 class="event-heading">India’s First Fleet of EV Trucks Flagged Off</h3>
									<div class="event-description">
										<div class="desc-icon"><img src="images/icon-star.svg" alt=""></div>
